{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check": "npm run lint && npm run typecheck && npm test",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "node -e \"const{rmSync,existsSync}=require('node:fs');for(const p of ['dist','node_modules/.tmp','node_modules/.vite','node_modules/.cache','storybook-static','playwright-report','test-results']){if(existsSync(p)){rmSync(p,{recursive:true,force:true});console.log('removed',p);}}\"",
    "prepare": "husky",
    "test:layers": "playwright test --config=playwright.storybook.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-table": "9.2.4",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.6",
    "react-hook-form": "7.89.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/tanstack-react": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-security": "4.1.0",
    "eslint-plugin-storybook": "10.6.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-checker": "0.14.5",
    "vitest": "5.0.2"
  },
  "overrides": {
    "@tanstack/router-core": "1.171.29"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
