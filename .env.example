# URL base da API (obrigatória)
VITE_API_URL=http://localhost:8080/api

# Implementação da sessão: `api` (padrão) autentica no backend de VITE_API_URL
# (../server-template); `fake` aceita qualquer e-mail válido e senha não vazia,
# sem backend (demonstração). Os testes e os E2E rodam em `fake`.
VITE_SESSION_MODE=api

# Identificação do projeto (usada nos logs de erro)
VITE_PROJECT_NAME=Frontend
VITE_PROJECT_ENVIRONMENT=Sandbox
VITE_PROJECT_SIDE=Client

# Endpoint opcional para reporte de erros em produção.
# Deixe vazio/ausente para desativar o envio.
VITE_ERROR_LOG_URL=
